# ---------------------------------------------------------------------------
# Diaromas - variables de entorno
# Copia este archivo a .env  ->  cp .env.example .env
# .env está en .gitignore, nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=Villas00.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- HTTPS / producción (déjalos commented mientras desarrollas) -----------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True
# DJANGO_TRUST_PROXY=True          # detrás de Nginx/Caddy/Cloudflare

# --- PostgreSQL -------------------------------------------------------------
# Dentro de docker compose el host es el nombre del servicio: db
POSTGRES_DB=diaromas
POSTGRES_USER=diaromas
POSTGRES_PASSWORD=diaromas_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto publicado en el host (opcional)
POSTGRES_PORT_PUBLISHED=5432
# Segundos que espera la app antes de abandonar la conexión a la BD
POSTGRES_CONNECT_TIMEOUT=5

# Alternativa a las variables anteriores (tiene prioridad si se define):
# DATABASE_URL=postgresql://diaromas:diaromas_dev_password@db:5432/diaromas

# --- Negocio ----------------------------------------------------------------
# Número de WhatsApp en formato internacional, solo dígitos y sin '+'.
# Ejemplo Chile: 56987654321
WHATSAPP_NUMBER=56944428467

# Datos que se incluyen en el mensaje del pedido
CURRENCY=CLP
IVA_RATE=0.19
IVA_INCLUDED=True

# --- Comportamiento del entrypoint -----------------------------------------
# Cargar el catálogo inicial de data/productos.json en cada arranque
DJANGO_SEED_ON_START=1
# Ejecutar collectstatic al arrancar (solo necesario en producción)
DJANGO_COLLECTSTATIC=0